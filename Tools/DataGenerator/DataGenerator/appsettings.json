{
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "Microsoft.AspNetCore.HttpLogging": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.EventLog" ],
        "MinimumLevel": "Information",
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/log-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 7,
                    "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level}] {Message}{NewLine}{Exception}"
                }
            },
            {
                "Name": "EventLog",
                "Args": {
                    "source": "AdvertisingPlatforms.Web",
                    "logName": "Application",
                    "restrictedToMinimumLevel": "Fatal",
                    "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level}] {Message}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [ "FromLogContext" ]
    },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ComandTopic": "generation-commands",
    "DataTopic": "advertising-platforms",
    "ConsumerGroupId": "adv-platforms-consumer",
    "EnableAutoCreateTopics": true,
    "MaxBatchSize": 500,
    "MaxBatchBytes": 1048576,
    "PollIntervalMs": 10000,
    "CommitIntervalMs": 5000
  }
}
