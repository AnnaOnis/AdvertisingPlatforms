{
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "Microsoft.AspNetCore.HttpLogging": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "ConnectionStrings": {
        "DefaultConnection": "Server=88.218.62.221;Database=delivery4;User Id=user4;Password=P@ssw0rd_4;"
    },
    "UseDatabase": true,
    "AllowedHosts": "*",
    "LogOptions": {
        "EnableRequestLogging": true,
        "EnableResponseLogging": true,
        "BodyLogLimit": 8192,
        "SensitiveKeys": [ "password", "token" ],
        "ExcludePaths": [ "/swagger" ],
        "IncludeHeaders": true
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.EventLog" ],
        "MinimumLevel": "Information",
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/log-.log",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 7,
                    "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level}] {Message}{NewLine}{Exception}"
                }
            },
            {
                "Name": "EventLog",
                "Args": {
                    "source": "AdvertisingPlatforms.Web",
                    "logName": "Application",
                    "restrictedToMinimumLevel": "Fatal",
                    "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level}] {Message}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [ "FromLogContext" ]
    }
}
